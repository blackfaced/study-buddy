# Study Buddy — environment variables template
# Copy this to `.env` and fill in the values for your deployment.
# `.env` is gitignored.

# === LLM ===
# MiniMax API key (text + vision)
MINIMAX_API_KEY=
# Optional: override the chat model (default "MiniMax-Text-01")
MINIMAX_MODEL=

# === Server ===
# Port for the HTTPS server (default 3000)
STUDY_BUDDY_PORT=3000

# === Buddy PIN gate (issue #55) ===
# 4-digit PIN that parents enter to open /buddy/ chat.
# Leave empty/blank in dev — server logs a warning and runs unlocked.
# Format: exactly 4 digits (e.g. 8864).
BUDDY_PIN=

# === Buddy chat toggle ===
# Set to "false" (or "0") to hide the /buddy/ chat UI — photo capture
# (拍错题) stays available. Unset/empty/"true" keeps the chat on.
# BUDDY_CHAT_ENABLED=true

# === Local provider integration feed (issue #104) ===
# Independent high-entropy Bearer token for the loopback-only Source Event API.
# Do not reuse BUDDY_PIN. Generate one with: openssl rand -hex 32
INTEGRATION_API_TOKEN=

# Optional override used only by the retired legacy worker guard.
# SOURCE_FEED_CUTOVER_MARKER=/absolute/path/to/data/source-feed-cutover.json

# === Optional: Vision LLM (for /api/mistake-photo) ===
# Default is MiniMax; override only if you self-host.
# LLM_BASE_URL=

# === Feishu reminders (bin/feishu-reminder.js, bin/friday-weekend-reminder.js) ===
# Two transports; webhook wins when both are set. Neither set = quiet skip.
# 1. Custom-bot signed webhook (needs a team group bot):
# FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=
# 2. App bot via Open API (works with personal-edition-created apps, e.g.
#    the Mavis Feishu bot — personal accounts can't add custom bots):
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=
